# Auth0 — SPA Inftec Portal (sem client secret no frontend)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.saas.inftec.com
VITE_AUTH0_CALLBACK_PATH=/app

# API INFTEC Portal (local)
VITE_API_BASE_URL=http://localhost:5000
VITE_INFTEC_PORTAL_SWAGGER_URL=http://localhost:5000/swagger/inftec-portal/swagger.json

